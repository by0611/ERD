    .ai-command-shell {{ background-color: #000000; color: #39ff14; padding: 15px; border-radius: 8px 8px 0 0; font-family: 'Consolas', monospace; font-size: 0.95em; border-left: 5px solid #39ff14; margin-bottom: 2px; }}
    .ai-think-shell {{ background-color: #2b2b2b; color: #ffffff; padding: 15px; border-radius: 0 0 8px 8px; font-family: sans-serif; font-size: 0.95em; border-left: 5px solid #ffffff; margin-bottom: 15px; line-height: 1.6; }}
    .how-to-use {{ background-color: #e3f2fd; border: 1px solid #2196f3; padding: 15px; border-radius: 8px; color: #0d47a1; margin-bottom: 20px; }}
